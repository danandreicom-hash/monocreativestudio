{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name for this project.
  "name": "monocreativestudio",
  "compatibility_date": "2026-07-01",

  // Site 100% static — Cloudflare servește fișierele din dist/ direct, fără
  // worker (fără câmp "main"). Formularul de contact e un Worker separat,
  // definit în workers/contact-form/wrangler.jsonc — vezi README § Formularul
  // de contact.
  // Only "/" runs the edge Worker (language by visitor country, D-013);
  // every other request is served directly from the static assets.
  "main": "workers/edge-language/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/"],
  },

  // Production domain (D-023). Indexing stays off until the release build (G4).
  "routes": [
    { "pattern": "monocreativestudio.com", "custom_domain": true },
    { "pattern": "www.monocreativestudio.com", "custom_domain": true },
  ],

  "observability": {
    "enabled": true,
  },
}
