---
/**
 * Minimal schema.org Organization: name and url only. Add address, phone,
 * logo and sameAs only after Vladimir confirms them (D-002).
 * Rendered once, in BaseLayout.astro.
 */
import { siteConfig } from "@data/site.config";

const siteURL = Astro.site?.toString().replace(/\/$/, "");

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteConfig.companyName,
  url: siteURL,
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
