---
import { siteConfig } from "@data/site.config";
import Container from "@components/ui/Container.astro";

const year = new Date().getFullYear();
const { email, phone } = siteConfig.contact;
---

<footer class="bg-[#2b2b2c] text-white">
  <Container class="flex flex-col gap-3 py-12 text-sm text-white/85">
    <img
      src="/brand/mono-mark-square.svg"
      alt={siteConfig.companyName}
      width="56"
      height="56"
      class="size-14 outline outline-1 outline-white/30"
      loading="lazy"
    />
    <p>{siteConfig.tagline}</p>
    {email && <a href={`mailto:${email}`}>{email}</a>}
    {phone && <a href={`tel:${phone.replace(/\s/g, "")}`}>{phone}</a>}
    {
      siteConfig.footerLinks.length > 0 && (
        <ul class="flex gap-5">
          {siteConfig.footerLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      )
    }
    <p class="text-white/70">© {year} {siteConfig.companyName}</p>
  </Container>
</footer>
