---
import { siteConfig } from "@data/site.config";
import { getT, href, type Lang } from "@i18n/index";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getT(lang);
const h = (p: Parameters<typeof href>[1], anchor?: string) => href(lang, p, anchor);
---

<footer class="site">
  <div class="wrap fgrid">
    <div class="fbrand">
      <img
        class="logo"
        style="width:72px"
        alt="MONO Creative Studio"
        src="/brand/mono-mark-square-light.svg"
      />
      <p class="small">{t.owner}</p>
    </div>
    <div class="cols">
      <a href={h("shop")}>{t.nShop}</a>
      <a href={h("lab")}>{t.nLab}</a>
      <a href={h("about")}>{t.nAbout}</a>
      <a href={h("contact")}>{t.nContact}</a>
    </div>
    <div class="small">
      <div><a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a></div>
      <div>
        <a href={`tel:${siteConfig.contact.phone.replace(/\s/g, "")}`}>{siteConfig.contact.phone}</a
        >
      </div>
      <div>
        <span>{t.fPartners}</span>{" "}
        <a href="https://conceptiones.com" target="_blank" rel="noopener">Conceptiones</a>{" "}
        <span>{t.and}</span>{" "}
        <a href="https://arthalle.com" target="_blank" rel="noopener">Arthalle</a>
      </div>
    </div>
  </div>
</footer>
