---
import { siteConfig } from "@data/site.config";
import Container from "@components/ui/Container.astro";

const year = new Date().getFullYear();
const { email, phone } = siteConfig.contact;
---

<footer class="border-t border-stone-200 bg-stone-50">
  <Container class="flex flex-col gap-3 py-10 text-sm text-stone-600">
    <p class="font-display text-lg font-semibold text-stone-900">{siteConfig.companyName}</p>
    <p>{siteConfig.tagline}</p>
    {email && <a href={`mailto:${email}`}>{email}</a>}
    {phone && <a href={`tel:${phone.replace(/\s/g, "")}`}>{phone}</a>}
    {
      siteConfig.footerLinks.length > 0 && (
        <ul class="flex gap-5">
          {siteConfig.footerLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      )
    }
    <p class="text-stone-500">© {year} {siteConfig.companyName}</p>
  </Container>
</footer>
