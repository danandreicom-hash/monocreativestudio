---
import { siteConfig } from "@data/site.config";
import Container from "@components/ui/Container.astro";
import Button from "@components/ui/Button.astro";
import Icon from "@components/icons/Icon.astro";

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b border-slate-100 bg-white/90 backdrop-blur-sm">
  <Container class="flex h-18 items-center justify-between py-4">
    <a href="/" class="font-display text-xl font-semibold text-slate-900">
      {siteConfig.companyName}
    </a>

    <!-- Navigare desktop -->
    <nav aria-label="Principală" class="hidden items-center gap-8 lg:flex">
      {
        siteConfig.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "text-sm font-medium transition-colors",
              isActive(item.href) ? "text-brand-700" : "text-slate-600 hover:text-slate-900",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <Button href="/contact" size="md">Discută cu noi</Button>
    </nav>

    <!-- Meniu mobil — <details>/<summary> funcționează fără JavaScript. -->
    <details class="group relative lg:hidden">
      <summary
        class="flex size-10 list-none items-center justify-center rounded-md text-slate-700 [&::-webkit-details-marker]:hidden"
        aria-label="Deschide meniul de navigare"
      >
        <Icon name="menu" class="size-6 group-open:hidden" />
        <Icon name="close" class="hidden size-6 group-open:block" />
      </summary>
      <nav
        aria-label="Principală (mobil)"
        class="absolute top-full right-0 mt-2 w-64 rounded-2xl bg-white p-4 shadow-(--shadow-card) ring-1 ring-slate-100"
      >
        <ul class="flex flex-col gap-1">
          {
            siteConfig.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "block rounded-lg px-3 py-2 text-sm font-medium",
                    isActive(item.href)
                      ? "bg-brand-50 text-brand-700"
                      : "text-slate-700 hover:bg-slate-50",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <Button href="/contact" class="mt-3 w-full">Discută cu noi</Button>
      </nav>
    </details>
  </Container>
</header>
