---
import { siteConfig } from "@data/site.config";
import Container from "@components/ui/Container.astro";
import Icon from "@components/icons/Icon.astro";

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b border-stone-200 bg-white/90 backdrop-blur-sm">
  <Container class="flex h-18 items-center justify-between py-4">
    <a href="/" class="font-display text-xl font-semibold text-stone-900">
      {siteConfig.companyName}
    </a>

    <nav aria-label="Main" class="hidden items-center gap-8 lg:flex">
      {
        siteConfig.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "text-sm font-medium transition-colors",
              isActive(item.href) ? "text-stone-900" : "text-stone-600 hover:text-stone-900",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <details class="group relative lg:hidden">
      <summary
        class="flex size-10 list-none items-center justify-center rounded-md text-stone-700 [&::-webkit-details-marker]:hidden"
        aria-label="Open navigation menu"
      >
        <Icon name="menu" class="size-6 group-open:hidden" />
        <Icon name="close" class="hidden size-6 group-open:block" />
      </summary>
      <nav
        aria-label="Main (mobile)"
        class="absolute top-full right-0 mt-2 w-64 rounded-md bg-white p-4 ring-1 ring-stone-200"
      >
        <ul class="flex flex-col gap-1">
          {
            siteConfig.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "block rounded px-3 py-2 text-sm font-medium",
                    isActive(item.href)
                      ? "bg-stone-100 text-stone-900"
                      : "text-stone-700 hover:bg-stone-50",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </Container>
</header>
