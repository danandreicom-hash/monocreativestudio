---
import { getT, href, type Lang, type Page } from "@i18n/index";
interface Props {
  lang: Lang;
  page: Page;
}
const { lang, page } = Astro.props;
const t = getT(lang);
const h = (p: Page, anchor?: string) => href(lang, p, anchor);
const switchHref = (l: Lang) => href(l, page);
---

<header class="site">
  <div class="wrap">
    <a class="logo-link" aria-label="MONO Creative Studio" href={h("home")}
      ><img class="logo" alt="MONO Creative Studio" src="/brand/mono-logo-horizontal.svg" /></a
    >
    <nav class="main" aria-label="Main">
      <a href={h("shop")} aria-current={page === "shop" ? "page" : undefined}>{t.nShop}</a>
      <a href={h("lab")} aria-current={page === "lab" ? "page" : undefined}>{t.nLab}</a>
      <a href={h("about")} aria-current={page === "about" ? "page" : undefined}>{t.nAbout}</a>
      <a href={h("contact")} aria-current={page === "contact" ? "page" : undefined}>{t.nContact}</a>
    </nav>
    <div class="lang" role="group" aria-label="Language / Limbă">
      {
        (["ro", "en"] as const).map((l) => (
          <a
            href={switchHref(l)}
            lang={l}
            hreflang={l}
            data-lang={l}
            aria-current={l === lang ? "true" : undefined}
            aria-label={l === "ro" ? "Română" : "English"}
          >
            {l.toUpperCase()}
          </a>
        ))
      }
    </div>
    <a class="btn" href={h("lab", "lab-form")}>{t.quote}</a>
  </div>
</header>
