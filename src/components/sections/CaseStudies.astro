---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Container from "@components/ui/Container.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import Icon from "@components/icons/Icon.astro";

interface Props {
  title?: string;
  description?: string;
  featuredOnly?: boolean;
  limit?: number;
}

const {
  title = "Studii de caz",
  description = "Rezultate concrete, măsurabile, din proiecte recente cu clienți din producție, retail și industria alimentară.",
  featuredOnly = false,
  limit,
} = Astro.props;

let caseStudies = (await getCollection("case-studies")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
if (featuredOnly) caseStudies = caseStudies.filter((c) => c.data.featured);
if (limit) caseStudies = caseStudies.slice(0, limit);
---

<section id="portofoliu" class="bg-slate-50 py-20 sm:py-28">
  <Container>
    <SectionHeading eyebrow="Rezultate" title={title} description={description} />
    <div class="mt-14 grid gap-8 lg:grid-cols-3">
      {
        caseStudies.map((study) => (
          <a
            href={`/portofoliu/${study.id}`}
            class="group flex flex-col overflow-hidden rounded-(--radius-card) bg-white shadow-(--shadow-card) transition-shadow hover:shadow-lg"
          >
            <Image
              src={study.data.coverImage}
              alt={study.data.coverImageAlt}
              width={600}
              height={400}
              class="aspect-3/2 w-full object-cover"
            />
            <div class="flex flex-1 flex-col p-6">
              <p class="text-brand-600 text-xs font-semibold tracking-wide uppercase">
                {study.data.industry}
              </p>
              <h3 class="mt-2 text-lg font-semibold text-slate-900">{study.data.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{study.data.summary}</p>
              <div class="mt-4 flex flex-wrap gap-x-5 gap-y-1 border-t border-slate-100 pt-4">
                {study.data.results.slice(0, 2).map((result) => (
                  <div>
                    <p class="font-display text-xl font-semibold text-slate-900">{result.value}</p>
                    <p class="text-xs text-slate-500">{result.label}</p>
                  </div>
                ))}
              </div>
              <span class="text-brand-600 mt-5 inline-flex items-center gap-1 text-sm font-medium transition-[gap] group-hover:gap-2">
                Vezi studiul de caz
                <Icon name="arrowRight" class="size-4" />
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </Container>
</section>
