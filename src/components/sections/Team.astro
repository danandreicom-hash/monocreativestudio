---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Container from "@components/ui/Container.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import Icon from "@components/icons/Icon.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Echipa",
  description = "Consultanți cu experiență operațională reală, nu doar teoretică.",
} = Astro.props;

const team = (await getCollection("team")).sort((a, b) => a.data.order - b.data.order);
---

<section id="echipa" class="py-20 sm:py-28">
  <Container>
    <SectionHeading eyebrow="Cine suntem" title={title} description={description} />
    <ul class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        team.map((member) => (
          <li class="text-center">
            <Image
              src={member.data.photo}
              alt={`Fotografie de portret — ${member.data.name}`}
              width={240}
              height={240}
              class="mx-auto aspect-square w-32 rounded-full object-cover sm:w-40"
            />
            <h3 class="mt-4 font-semibold text-slate-900">{member.data.name}</h3>
            <p class="text-sm text-slate-600">{member.data.role}</p>
            {member.data.linkedinUrl && (
              <a
                href={member.data.linkedinUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Profilul LinkedIn al lui ${member.data.name}`}
                class="hover:text-brand-600 mt-2 inline-flex text-slate-400"
              >
                <Icon name="linkedin" class="size-4" />
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </Container>
</section>
