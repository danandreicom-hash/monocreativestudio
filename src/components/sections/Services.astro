---
import { getCollection } from "astro:content";
import Container from "@components/ui/Container.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import Icon from "@components/icons/Icon.astro";

interface Props {
  title?: string;
  description?: string;
  featuredOnly?: boolean;
  linkToDetail?: boolean;
}

const {
  title = "Servicii",
  description = "Consultanță de business structurată pe patru arii, adaptată la stadiul companiei tale.",
  featuredOnly = false,
  linkToDetail = false,
} = Astro.props;

let services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
if (featuredOnly) services = services.filter((s) => s.data.featured);
---

<section id="servicii" class="py-20 sm:py-28">
  <Container>
    <SectionHeading eyebrow="Ce facem" title={title} description={description} />
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => {
          const CardTag = linkToDetail ? "a" : "div";
          return (
            <CardTag
              href={linkToDetail ? `/servicii/${service.id}` : undefined}
              class="group rounded-(--radius-card) border border-slate-100 bg-white p-7 shadow-(--shadow-card) transition-shadow hover:shadow-lg"
            >
              <div class="bg-brand-50 text-brand-600 flex size-11 items-center justify-center rounded-xl">
                <Icon name={service.data.icon} class="size-6" />
              </div>
              <h3 class="mt-5 text-lg font-semibold text-slate-900">{service.data.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{service.data.shortDescription}</p>
              {linkToDetail && (
                <span class="text-brand-600 mt-4 inline-flex items-center gap-1 text-sm font-medium transition-[gap] group-hover:gap-2">
                  Detalii
                  <Icon name="arrowRight" class="size-4" />
                </span>
              )}
            </CardTag>
          );
        })
      }
    </div>
  </Container>
</section>
