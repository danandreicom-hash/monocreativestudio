---
import Container from "@components/ui/Container.astro";
import Button from "@components/ui/Button.astro";

interface Props {
  title: string;
  description?: string;
  buttonLabel: string;
  buttonHref: string;
}

const { title, description, buttonLabel, buttonHref } = Astro.props;
---

<section class="py-20 sm:py-28">
  <Container>
    <div class="bg-brand-900 rounded-(--radius-card) px-8 py-14 text-center sm:px-16 sm:py-16">
      <h2 class="text-3xl text-white sm:text-4xl">{title}</h2>
      {description && <p class="text-brand-100 mx-auto mt-4 max-w-xl text-lg">{description}</p>}
      <div class="mt-8">
        <Button href={buttonHref} variant="secondary" size="lg">
          {buttonLabel}
        </Button>
      </div>
    </div>
  </Container>
</section>
