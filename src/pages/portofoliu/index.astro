---
import BaseLayout from "@layouts/BaseLayout.astro";
import CaseStudies from "@components/sections/CaseStudies.astro";
import Cta from "@components/sections/Cta.astro";
import { siteConfig } from "@data/site.config";
---

<BaseLayout
  title="Studii de caz"
  description={`Rezultate concrete din proiectele ${siteConfig.companyName} — strategie, finanțe, digitalizare și optimizare operațională.`}
>
  <div class="pt-12">
    <CaseStudies title="Studii de caz" description="Proiecte recente, cu rezultate măsurabile." />
  </div>

  <Cta
    title="Vrei rezultate similare pentru compania ta?"
    buttonLabel="Discută cu noi"
    buttonHref="/contact"
  />
</BaseLayout>
