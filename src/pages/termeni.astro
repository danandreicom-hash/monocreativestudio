---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import { siteConfig } from "@data/site.config";
---

<BaseLayout
  title="Termeni și condiții"
  description={`Termenii și condițiile de utilizare a site-ului ${siteConfig.companyName}.`}
>
  <Container class="max-w-3xl py-16 sm:py-24">
    <h1 class="text-4xl">Termeni și condiții</h1>
    <div class="prose prose-slate prose-headings:font-display mt-8 max-w-none">
      <p>
        <em>
          Acesta este un text-cadru, de revizuit împreună cu un consultant juridic înainte de
          lansarea site-ului live, adaptat activității reale a {siteConfig.legalName}.
        </em>
      </p>
      <h2>Utilizarea site-ului</h2>
      <p>
        Conținutul acestui site are caracter informativ și nu constituie consultanță de
        specialitate. Orice decizie de business trebuie fundamentată printr-o discuție directă cu
        echipa {siteConfig.companyName}.
      </p>
      <h2>Proprietate intelectuală</h2>
      <p>
        Conținutul acestui site (texte, imagini, studii de caz) aparține {siteConfig.legalName} și nu
        poate fi reprodus fără acord scris prealabil.
      </p>
    </div>
  </Container>
</BaseLayout>
