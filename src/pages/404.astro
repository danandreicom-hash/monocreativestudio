---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Button from "@components/ui/Button.astro";
---

<BaseLayout title="Pagina nu a fost găsită" noindex>
  <Container class="flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <p class="font-display text-brand-600 text-lg font-semibold">404</p>
    <h1 class="mt-3 text-3xl sm:text-4xl">Ne pare rău, nu am găsit pagina căutată.</h1>
    <p class="mt-4 max-w-md text-slate-600">
      Este posibil ca link-ul să fie greșit sau pagina să fi fost mutată.
    </p>
    <Button href="/" class="mt-8" size="lg">Înapoi la pagina principală</Button>
  </Container>
</BaseLayout>
