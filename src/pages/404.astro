---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Button from "@components/ui/Button.astro";
---

<BaseLayout title="Page not found" noindex>
  <Container class="flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <p class="font-display text-lg font-semibold text-stone-500">404</p>
    <h1 class="mt-3 text-3xl sm:text-4xl">We could not find that page.</h1>
    <p class="mt-4 max-w-md text-stone-600">The link may be wrong or the page may have moved.</p>
    <Button href="/" class="mt-8" size="lg">Back to home</Button>
  </Container>
</BaseLayout>
