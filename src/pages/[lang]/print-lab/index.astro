---
import BaseLayout from "@layouts/BaseLayout.astro";
import Lab from "@components/pages/Lab.astro";
import { langs, meta, type Lang } from "@i18n/index";

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const m = meta[lang]["lab"];
---

<BaseLayout title={m.title} description={m.description} lang={lang} page="lab">
  <Lab lang={lang} />
</BaseLayout>
