---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import { siteConfig } from "@data/site.config";
---

<BaseLayout title={siteConfig.companyName} description={siteConfig.defaultMetaDescription} noindex>
  <Container class="flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <h1 class="text-4xl sm:text-5xl">{siteConfig.companyName}</h1>
    <p class="mt-4 text-stone-600">{siteConfig.tagline}</p>
    <p class="mt-2 text-sm text-stone-500">Site in preparation.</p>
  </Container>
</BaseLayout>
