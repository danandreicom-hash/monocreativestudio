---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import { siteConfig } from "@data/site.config";
---

<BaseLayout
  title="Politica de confidențialitate"
  description={`Politica de confidențialitate a ${siteConfig.companyName}.`}
>
  <Container class="max-w-3xl py-16 sm:py-24">
    <h1 class="text-4xl">Politica de confidențialitate</h1>
    <div class="prose prose-slate prose-headings:font-display mt-8 max-w-none">
      <p>
        <em>
          Acesta este un text-cadru de completat cu ajutorul unui consultant juridic, adaptat
          prelucrărilor de date reale efectuate de {siteConfig.companyName} (formular de contact, eventuale
          cookie-uri de analiză, newsletter etc.), înainte de lansarea site-ului live.
        </em>
      </p>
      <h2>Ce date colectăm</h2>
      <p>
        Prin formularul de contact colectăm numele, adresa de email, compania (opțional) și
        conținutul mesajului transmis, exclusiv pentru a răspunde solicitării tale.
      </p>
      <h2>Cum folosim datele</h2>
      <p>
        Datele transmise prin formularul de contact sunt folosite exclusiv pentru a răspunde
        solicitării tale și nu sunt cedate către terți în scopuri de marketing.
      </p>
      <h2>Drepturile tale (GDPR)</h2>
      <p>
        Ai dreptul de acces, rectificare, ștergere și opoziție la prelucrarea datelor tale. Pentru
        exercitarea acestor drepturi, scrie-ne la
        <a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a>.
      </p>
    </div>
  </Container>
</BaseLayout>
